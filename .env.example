# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings > API Keys). Sin estas variables la app corre en modo demostración.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tu-llave-publica

# Solo en el servidor: permite enviar invitaciones a usuarios nuevos.
# Nunca la compartas ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_tu-llave-secreta
